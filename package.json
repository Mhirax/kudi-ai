{
  "name": "kudi-ai-bank",
  "version": "0.1.0",
  "description": "Kudi AI Bank — Enterprise Backend Monorepo (NestJS + Rust Core Banking Engines)",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "build:mobile-api": "nest build mobile-api",
    "build:web-api": "nest build web-api",
    "build:admin-api": "nest build admin-api",
    "build:api-gateway": "nest build api-gateway",
    "start:mobile-api": "nest start mobile-api",
    "start:web-api": "nest start web-api",
    "start:admin-api": "nest start admin-api",
    "start:api-gateway": "nest start api-gateway",
    "start:mobile-api:watch": "nest start mobile-api --watch",
    "start:web-api:watch": "nest start web-api --watch",
    "start:admin-api:watch": "nest start admin-api --watch",
    "start:api-gateway:watch": "nest start api-gateway --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{apps,gateway,modules,shared,infrastructure,integrations,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,gateway,modules,shared,infrastructure,integrations,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,gateway,modules,shared,infrastructure,integrations,tests}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest --config tests/unit/jest.config.ts",
    "test:integration": "jest --config tests/integration/jest.config.ts",
    "test:e2e": "jest --config tests/e2e/jest-e2e.config.ts",
    "test:cov": "jest --config tests/unit/jest.config.ts --coverage",
    "prisma:generate": "prisma generate --schema=infrastructure/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=infrastructure/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=infrastructure/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=infrastructure/prisma/schema.prisma",
    "prepare": "husky install"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "nest-winston": "^1.9.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.5.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.5",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "commitlint": "^19.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
